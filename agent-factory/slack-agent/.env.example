# Slack Bot API Credentials (Socket Mode)
# Obtain from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# GitHub API Credentials
# Obtain Personal Access Token from https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPOSITORY=anishs1207/inqora
GITHUB_BASE_BRANCH=main

# Gemini API Key for LLM code generation
GEMINI_API_KEY=your_gemini_api_key

# Optional Server Port
PORT=3000
