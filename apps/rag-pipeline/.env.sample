# ==============================================================================
# Inqora RAG Pipeline - Environment Sample Configuration (.env)
# ==============================================================================

# --- Project & Environment ---
APP_NAME="Inqora RAG Pipeline"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# --- LLM Provider API Keys ---
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# --- RAG Proxy Authentication & Security ---
# Comma-separated list of valid API keys for authenticating requests
ALLOWED_API_KEYS="inqora_dev_key,secret_api_key_123"
RATE_LIMIT_RPM=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- AI Economics & Budget Thresholds ---
DEFAULT_CLIENT_BUDGET_USD=10.00
BUDGET_WARNING_THRESHOLD_PCT=80.0

# --- Gmail / SMTP Email Alerting ---
GMAIL_SENDER_EMAIL="anishs1207@gmail.com"
GMAIL_APP_PASSWORD="your_gmail_app_password_here"
ALERT_RECIPIENT_EMAIL="anishs1207@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# --- Databases & Cache ---
DATABASE_URL="postgresql://user:password@localhost:5432/agentic_db?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6379

# --- Logging ---
LOG_DIR="./logs"
LOG_LEVEL="INFO"
